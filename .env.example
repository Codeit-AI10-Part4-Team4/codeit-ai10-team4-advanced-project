# .env.example — 복사해서 .env 로 쓰세요.  cp .env.example .env
# .env 는 gitignore 됩니다. 키를 커밋하지 마세요.

# ── LLM ──────────────────────────────────────────────────
# 모델 프로필 — stub | openai | local
#   stub    API 키 없이 화면만 볼 때.
#           ⚠️ 챗봇도 문구 생성도 **빈 결과**가 나온다. 화면 배치만 볼 때 쓴다.
#   openai  실제로 대화·문구 생성을 할 때. 아래 키가 필요하다
MODEL_PROFILE=stub
OPENAI_API_KEY=

# 챗봇(대화·NLU)만 다른 모델로 돌리고 싶을 때. 비워두면 기본 모델을 쓴다.
#   llm.py 의 기본 모델을 바꾸면 문구·손님 패널·사진 판정까지 전부 같이 바뀌어
#   그쪽 A/B·골든셋 기준선이 흔들린다. 대화만 올리려면 여기에 적는다.
#   MODEL_PROFILE=stub 이면 무시한다 (키 없는 환경이 실 API 를 부르면 안 된다).
ADS_CHAT_MODEL=

# ── 이미지 생성 ───────────────────────────────────────────
# 이미지 백엔드 프로필 — local | openai
#   local   사진 없음은 sd-turbo(GPU), 업로드 사진은 비용 없는 안전 보정. 기본값이다.
#   openai  사진 없음은 gpt-image-2 생성, 업로드 사진은 감성형·포스터형을 각각
#           고품질 광고 촬영본으로 재연출한다. OPENAI_API_KEY가 필요하다.
#           업로드 재촬영 실패는 안전 보정, 사진 없는 생성 실패는 local로 폴백한다.
IMAGE_PROFILE=local

# ── 턴 로그 ───────────────────────────────────────────────
# 대화 한 턴마다 사장님 발화와 그때 뽑힌 값을 data/turns.jsonl 에 남긴다.
# 골든셋(평가셋)을 실제 발화로 채우는 원천이라 **기본은 켜짐**이다.
# data/ 는 gitignore 라 저장소에는 올라가지 않는다.
#
# ⚠️ 실제 사장님에게 여는 배포에서는 0 으로 끄거나 동의를 받을 것 — 남는 것이
#    발화 원문이라 개인정보가 섞일 수 있다.
ADS_TURNLOG_ENABLED=1

# ── 상권 조회 (AI 손님 패널) ──────────────────────────────
# 주소 → 좌표 변환용. 발급·관리는 이아인 님이 합니다.
# 챗봇·문구 생성에는 필요 없으니 비워둬도 됩니다.
KAKAO_REST_KEY=

# ── DB ───────────────────────────────────────────────────
# docker compose 로 띄우면 compose.yaml 이 이 값을 덮어쓴다
# (컨테이너 안에서는 호스트가 localhost 가 아니라 db 다)
#
# 도커 없이 로컬에서 돌릴 때는 아래 중 하나를 쓰세요.
#   PostgreSQL 을 따로 띄웠다면
DATABASE_URL=postgresql+psycopg://ads:ads@localhost:5432/ads
#   DB 없이 파일 하나로 빠르게 보고 싶다면 (위 줄을 지우고)
# DATABASE_URL=sqlite:///./dev.db
