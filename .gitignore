# ==========================================
# AI Team Project .gitignore
# Language/Tools: Python, Jupyter Notebook
# ==========================================

# --- Jupyter Notebook & Lab Outputs ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
checkpoint_*.ipynb
.virtual_documents/
.jupyter/
.local/share/jupyter/

# 주의: 노트북 출력 셀(실행 결과)이 diff를 오염시키고 저장소 용량을 키우는 문제는
# .gitignore로 해결되지 않습니다. nbstripout이 .gitattributes filter + pre-commit hook으로
# 구성되어 있으니 `pre-commit install`을 반드시 실행하세요.

# --- JupyterHub Runtime State ---
jupyterhub.sqlite
jupyterhub_cookie_secret
jupyterhub_config.py.bak
.jupyterhub-runtime/
jupyterhub-proxy.pid

# --- Python Build & Runtime ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
third-party/

# --- Conda ---
.conda/
envs/
conda-meta/
pkgs/
*.tar.bz2

# --- Environment Variables & Cloud Secrets (Security) ---
.env
.env.*
# 템플릿은 커밋한다 (키는 비어 있음)
!.env.example
.secrets
*.pem
*.p12
*.pfx
*.key
*.pub
id_rsa*
id_ed25519*

# Cloud Service Account / Credential Files
# *.json 전체를 막지 않고 명명 패턴으로 한정합니다.
*-key.json
*-keyfile.json
*-credentials.json
*sa-key.json
gcp-*.json
service-account*.json
secret_*.json
credentials/

# --- Data & Large Artifacts (Never commit heavy datasets) ---
*.csv
# 평가 골든셋 등 의도적으로 커밋하는 소형 CSV는 화이트리스트로 예외 처리
!golden_dataset*.csv
*.xlsx
*.jsonl
*.parquet
*.h5
*.pickle
*.pkl
*.npy
*.npz
*.sqlite
*.db
# `data/` 가 아니라 `data/*` 인 이유: 디렉터리를 통째로 제외하면 git 이 안으로
# 내려가지 않아 **안쪽 파일을 예외로 되살릴 수 없다.** 아래 panel.duckdb 예외가
# 먹으려면 이 꼴이어야 한다. data/raw/ 같은 하위 디렉터리는 그대로 제외된다.
data/*
datasets/
outputs/

# --- Model Artifacts & Training Logs ---
models/
weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.gguf
*.bin
*.tflite
runs/
lightning_logs/
wandb/
mlruns/
# 데모/검증용으로 특정 작은 모델 파일을 의도적으로 커밋해야 한다면
# 아래에 화이트리스트 예외를 추가하세요 (무시 규칙보다 반드시 아래쪽에 위치해야 동작합니다).
# 예시 : !models/demo_small.onnx

# --- Coding Agent ---
# AGENTS.md / CLAUDE.md 는 팀 공유 자산으로 커밋합니다 (이 템플릿의 정책).
# 개인별 지침은 홈 디렉토리(~/.claude/CLAUDE.md 등)에 두세요.
# 세션별 권한 허용목록 등 개인 설정도 커밋하지 않습니다.
.claude/

# --- OS & IDE Specifics ---
.DS_Store
.DS_Store?
._*
.Spotlight-V10
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/

# --- macOS 외장·네트워크 볼륨 (Finder 가 만드는 잔여물) ---
# .DS_Store / ._* 는 위 "OS & IDE Specifics" 에 이미 있음. 여기는 USB·NAS·Time Machine 용.
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# --- DuckDB (패널 모듈) ---
# data/ 가 이미 무시되지만 경로를 벗어나 생성되는 경우를 막는다.
*.duckdb
*.duckdb.wal

# --- 패널 DB 는 커밋한다 (2026-08-19) ---
# 17MB · 서울 열린데이터광장 공개 데이터에서 만든 파생 산출물이고, 이게 없으면
# **클론만으론 앱이 안 돌아간다.** 귀한님이 통합 스모크에서 그 벽에 막혔다.
# 원본 CSV 4종(197MB)은 그대로 커밋하지 않는다 — data/raw/ 는 여전히 제외다.
# 분기 데이터라 자주 바뀌지 않아 이력이 부풀 걱정도 작다.
!data/panel.duckdb

# --- 업종 매핑표는 커밋한다 ---
# 위 89행의 *.csv 가 소형 수기 매핑표까지 막는다.
# 06 기술계획서 §4.1 "노출 업종 ↔ 서울시 서비스업종코드 수기 매핑 CSV 1개"
!*_map.csv
